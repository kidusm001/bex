# Maintainer: Kidus Mesfin <kidusmesfin27@gmail.com>
pkgname=bex
pkgver=1.0.0
pkgrel=1
pkgdesc="Native Linux performance monitor built with Qt 6"
arch=('x86_64' 'aarch64')
url="https://github.com/kidusm001/bex"
license=('MIT')
depends=('qt6-base' 'libxcb' 'hicolor-icon-theme')
optdepends=('qt6-wayland: native Wayland window support')
makedepends=('cmake' 'ninja' 'pkgconf')
source=("${pkgname}-${pkgver}.tar.gz::${url}/releases/download/v${pkgver}/${pkgname}-${pkgver}.tar.gz")
sha256sums=('SKIP')

build() {
    cmake -B build -S "${pkgname}-${pkgver}" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DBEX_BUILD_TESTS=OFF \
        -DBEX_X11=ON
    cmake --build build
}

package() {
    DESTDIR="${pkgdir}" cmake --install build
    install -Dm644 "${pkgname}-${pkgver}/LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
}
