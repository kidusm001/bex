set(_manifest "@CMAKE_CURRENT_BINARY_DIR@/install_manifest.txt")
if(NOT EXISTS "${_manifest}")
    message(FATAL_ERROR "Nothing to uninstall: ${_manifest} not found. Run the install step first.")
endif()
file(STRINGS "${_manifest}" _files)
foreach(_file IN LISTS _files)
    set(_path "$ENV{DESTDIR}${_file}")
    if(EXISTS "${_path}" OR IS_SYMLINK "${_path}")
        message(STATUS "Removing ${_path}")
        file(REMOVE "${_path}")
    else()
        message(STATUS "Already absent: ${_path}")
    endif()
endforeach()
